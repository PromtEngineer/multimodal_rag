# RAG System Configuration
RAG_CONFIG_MODE=default
RAG_LOG_LEVEL=INFO
PORT=8000

# Ollama Configuration
OLLAMA_HOST=http://localhost:11434

# HuggingFace Token (optional, for private models)
HF_TOKEN=your_huggingface_token_here

# Database Configuration
DATABASE_PATH=./chat_data.db

# Storage Paths
UPLOAD_DIR=./shared_uploads
INDEX_STORE_DIR=./index_store
LANCEDB_DIR=./lancedb

# Model Configuration
DEFAULT_GENERATION_MODEL=qwen3:8b
DEFAULT_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
DEFAULT_ENRICHMENT_MODEL=qwen3:0.6b

# Performance Tuning
EMBEDDING_BATCH_SIZE=50
ENRICHMENT_BATCH_SIZE=25
MAX_CHUNK_SIZE=1500
CHUNK_OVERLAP=200 